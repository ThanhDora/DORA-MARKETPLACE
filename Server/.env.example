# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://marketplace:marketplace123@localhost:5432/minimarketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace123
POSTGRES_DB=minimarketplace

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:3001

# SMTP (Email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Mini Marketplace" <noreply@minimarketplace.com>

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# MoMo Payment
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# SePay Payment
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=your-sepay-merchant-id
SEPAY_SECRET_KEY=your-sepay-secret-key
# SePay IPN Token — dùng để xác thực webhook từ SePay (lấy từ my.sepay.vn → IPN)
SEPAY_IPN_TOKEN=your-sepay-ipn-token
# SePay API Token — dùng để lấy danh sách tài khoản ngân hàng
SEPAY_API_TOKEN=

# PayPal Payment
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Backend URL (for webhooks)
BACKEND_URL=http://localhost:3000
